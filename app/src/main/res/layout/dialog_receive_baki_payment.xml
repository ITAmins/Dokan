<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_baki_money_receive"
                app:tint="#059669"
                android:contentDescription="জমা"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvReceivePayDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="বাকি টাকা জমা গ্রহণ"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Customer Select or Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDlgPayCustomerInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#F0FDF4"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#BBF7D0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvDlgPayCustomerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="খরিদ্দার: -"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDlgPayCurrentDue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="বর্তমান বকেয়া: ৳ ০"
                    android:textColor="#DC2626"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Customer Dropdown (Visible if not pre-selected) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDlgPayCustomerSelect"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="গ্রাহক নির্বাচন করুন *"
            android:visibility="gone"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#059669">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actvDlgPayCustomerSelect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:completionThreshold="1"
                android:inputType="textPersonName"
                android:textColor="#0F172A"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Amount Received Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDlgPayAmount"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="জমা টাকার পরিমাণ *"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#059669"
            app:prefixText="৳ "
            app:prefixTextColor="#059669"
            app:prefixTextAppearance="@style/TextAppearance.Material3.TitleMedium">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDlgPayAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="#059669"
                android:textSize="18sp"
                android:textStyle="bold" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Payment Method Chips: Cash, bKash, Nagad, Bank -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="পরিশোধের মাধ্যম"
            android:textColor="#475569"
            android:textSize="11.5sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPayMethodCash"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:text="ক্যাশ"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="17dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPayMethodBkash"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:text="বিকাশ"
                    android:textSize="11sp"
                    app:cornerRadius="17dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPayMethodNagad"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:text="নগদ"
                    android:textSize="11sp"
                    app:cornerRadius="17dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPayMethodBank"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="ব্যাংক"
                    android:textSize="11sp"
                    app:cornerRadius="17dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Payment Note Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDlgPayNote"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="পরিশোধের নোট (ঐচ্ছিক)"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="#059669">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDlgPayNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="#0F172A"
                android:textSize="13.5sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Checkbox: Add to Today's Daily Cash (বেচায় যোগ) -->
        <CheckBox
            android:id="@+id/cbDlgPayAddToDailyCash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:checked="true"
            android:text="আজকের ক্যাশ হিসেবে (নগদ ইন) যোগ করুন"
            android:textColor="#1E293B"
            android:textSize="12.5sp" />

        <!-- Confirm Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDlgConfirmPay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="জমা নিশ্চিত করুন"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#059669"
            app:cornerRadius="14dp" />
    </LinearLayout>
</ScrollView>
