<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="18dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/shape_circle"
            android:backgroundTint="#EFF6FF"
            android:layout_marginEnd="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_calculator"
                app:tint="#2563EB" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="স্মার্ট খুচরা ক্যালকুলেটর"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="হিসাব করে সরাসরি বিক্রি, বাকি বা খরচে যোগ করুন"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCalcClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="#94A3B8" />
    </LinearLayout>

    <!-- Mode Selector Tabs: [ সাধারণ মোড ] | [ দর × পরিমাণ ] -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabCalcMode"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_filter_toggle_container"
        app:tabBackground="@drawable/bg_filter_tab_unselected"
        app:tabIndicator="@drawable/bg_filter_tab_selected"
        app:tabIndicatorColor="@null"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorGravity="stretch"
        app:tabMode="fixed"
        app:tabRippleColor="@null"
        app:tabSelectedTextColor="#2563EB"
        app:tabTextColor="#64748B">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="সাধারণ ক্যালকুলেটর" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="দর × পরিমাণ (কেজি/গ্রাম)" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Result Display Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#0F172A"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvCalcExpression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="০"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="start" />

            <TextView
                android:id="@+id/tvCalcResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="৳ ০"
                android:textColor="#38BDF8"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 1. STANDARD CALCULATOR VIEW -->
    <LinearLayout
        android:id="@+id/layoutStandardCalc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Row 1: C, ( ), %, ÷ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcClear"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="C"
                android:textColor="#DC2626"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#FEE2E2"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcBackspace"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="⌫"
                android:textColor="#475569"
                android:textSize="15sp"
                app:backgroundTint="#F1F5F9"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcPercent"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="%"
                android:textColor="#475569"
                android:textSize="15sp"
                app:backgroundTint="#F1F5F9"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcDiv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="÷"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:backgroundTint="#2563EB"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- Row 2: 7, 8, 9, × -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc7"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="7"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#F8FAFC"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc8"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="8"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#F8FAFC"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc9"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="9"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#F8FAFC"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcMul"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="×"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:backgroundTint="#2563EB"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- Row 3: 4, 5, 6, - -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc4"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="4"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#F8FAFC"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc5"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="5"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#F8FAFC"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc6"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="6"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#F8FAFC"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcSub"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:backgroundTint="#2563EB"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- Row 4: 1, 2, 3, + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc1"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="1"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#F8FAFC"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc2"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="2"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#F8FAFC"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc3"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="3"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#F8FAFC"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcAdd"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:backgroundTint="#2563EB"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- Row 5: 0, 00, ., = -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc0"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="0"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#F8FAFC"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc00"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="00"
                android:textColor="#0F172A"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#F8FAFC"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcDot"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                android:text="."
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="#F8FAFC"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcEqual"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="="
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="#059669"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. RATE × QUANTITY VIEW -->
    <LinearLayout
        android:id="@+id/layoutRateQtyCalc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Rate Input -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:hint="দর / রেট (৳)"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:prefixText="৳ ">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRatePrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Quantity Input -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:hint="পরিমাণ"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRateQty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Unit Chips (কেজি, গ্রাম, লিটার, পিস, ডজন, বস্তা) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="একক নির্বাচন করুন:"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipUnitKg"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_filter_tab_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="কেজি"
                    android:textColor="#2563EB"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipUnitGram"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_filter_tab_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="গ্রাম (/১০০০)"
                    android:textColor="#64748B"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipUnitLtr"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_filter_tab_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="লিটার"
                    android:textColor="#64748B"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipUnitPcs"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_filter_tab_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="পিস / টি"
                    android:textColor="#64748B"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipUnitDozen"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_filter_tab_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="ডজন"
                    android:textColor="#64748B"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipUnitSack"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_filter_tab_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="বস্তা"
                    android:textColor="#64748B"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Quick Qty presets: ২৫০ গ্রাম, ৫০০ গ্রাম, ১ কেজি, ২ কেজি, ৫ কেজি -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipPreset250g"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/shape_capsule_white"
                    android:backgroundTint="#F1F5F9"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="২৫০ গ্রাম"
                    android:textColor="#334155"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipPreset500g"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/shape_capsule_white"
                    android:backgroundTint="#F1F5F9"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="৫০০ গ্রাম"
                    android:textColor="#334155"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipPreset1"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/shape_capsule_white"
                    android:backgroundTint="#F1F5F9"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="১ (একক)"
                    android:textColor="#334155"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipPreset2"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/shape_capsule_white"
                    android:backgroundTint="#F1F5F9"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="২ (একক)"
                    android:textColor="#334155"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipPreset5"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/shape_capsule_white"
                    android:backgroundTint="#F1F5F9"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="৫ (একক)"
                    android:textColor="#334155"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- DIRECT POSTING ACTIONS SECTION (সরাসরি এন্ট্রি অপশন) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:text="হিসাবটি সরাসরি এন্ট্রি করুন:"
        android:textColor="#0F172A"
        android:textSize="12sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- নগদ বিক্রি -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPostToCashSale"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:text="নগদ বিক্রি"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                app:backgroundTint="#059669"
                app:cornerRadius="10dp" />

            <!-- বাকি বিক্রি -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPostToCreditSale"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:text="বাকি বিক্রি"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                app:backgroundTint="#DC2626"
                app:cornerRadius="10dp" />

            <!-- খরচ যোগ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPostToExpense"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:text="খরচ যোগ"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                app:backgroundTint="#D97706"
                app:cornerRadius="10dp" />

            <!-- বাজার ফর্দ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPostToFordi"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:text="বাজার ফর্দ"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                app:backgroundTint="#7C3AED"
                app:cornerRadius="10dp" />

            <!-- ক্যাশে বসান -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPostToCashDrawer"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="ক্যাশে বসান"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                app:backgroundTint="#2563EB"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
