<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_dark_container"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Header: Purple square icon, Title, Subtitle, Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="10dp"
            app:cardBackgroundColor="#7C3AED"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_calculator"
                app:tint="#FFFFFF" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="স্মার্ট খুচরা ক্যালকুলেটর"
                android:textColor="#FFFFFF"
                android:textSize="16.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="হিসাব করে এক ক্লিকে খাতা ও খরচে এন্ট্রি"
                android:textColor="#94A3B8"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCalcClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            app:tint="#94A3B8" />
    </LinearLayout>

    <!-- Mode Selector Tabs: [ সাধারণ যোগ-গুণ ] | [ দর ও একক হিসাব ] -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabCalcMode"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_calc_pill_dark"
        app:tabBackground="@null"
        app:tabIndicator="@drawable/bg_filter_tab_selected"
        app:tabIndicatorColor="@null"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorGravity="bottom"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabRippleColor="@null"
        app:tabSelectedTextColor="#FFFFFF"
        app:tabTextColor="#94A3B8">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="সাধারণ যোগ-গুণ" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="দর ও একক হিসাব" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Result Display Screen -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="#0D1B2A"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#1E293B"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/tvCalcExpression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="০"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="start" />

            <TextView
                android:id="@+id/tvCalcResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="৳ ০"
                android:textColor="#38BDF8"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- DIRECT POSTING ACTIONS SECTION (হিসাবকৃত টাকা সরাসরি এন্ট্রি করুন:) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="হিসাবকৃত টাকা সরাসরি এন্ট্রি করুন:"
        android:textColor="#CBD5E1"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- 4 Direct Posting Buttons in Horizontal Row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- নগদ বিক্রি -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPostToCashSale"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="💵 নগদ বিক্রি"
                android:textColor="#34D399"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="#064E3B"
                app:strokeColor="#059669"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp" />

            <!-- বাকি বিক্রি -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPostToCreditSale"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="👤 বাকি বিক্রি"
                android:textColor="#FCA5A5"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="#3B1818"
                app:strokeColor="#7F1D1D"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp" />

            <!-- খরচ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPostToExpense"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="📋 খরচ"
                android:textColor="#DDD6FE"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="#242535"
                app:strokeColor="#35364D"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp" />

            <!-- ফর্দ/কেনা -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPostToFordi"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="🛒 ফর্দ/কেনা"
                android:textColor="#DDD6FE"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="#242535"
                app:strokeColor="#35364D"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 1. STANDARD CALCULATOR VIEW (KEYPAD) -->
    <LinearLayout
        android:id="@+id/layoutStandardCalc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Row 1: C, ÷, ×, ⌫ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginBottom="7dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcClear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="C"
                android:textColor="#EF4444"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="#2D2F40"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcDiv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="÷"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                app:backgroundTint="#2D2F40"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcMul"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="×"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                app:backgroundTint="#2D2F40"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcBackspace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="⌫"
                android:textColor="#CBD5E1"
                android:textSize="17sp"
                app:backgroundTint="#2D2F40"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Row 2: 7, 8, 9, − -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginBottom="7dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="7"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="#242535"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="8"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="#242535"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="9"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="#242535"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcSub"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                app:backgroundTint="#2D2F40"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Row 3: 4, 5, 6, + -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginBottom="7dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="4"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="#242535"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="5"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="#242535"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="6"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="#242535"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcAdd"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                app:backgroundTint="#2D2F40"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Row 4: 1, 2, 3, = -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginBottom="7dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="#242535"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="2"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="#242535"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="3"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="#242535"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcEqual"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="="
                android:textColor="#1E1B4B"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#C4B5FD"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Row 5: 0, 00, ., ক্যাশে বসান -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="#242535"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalc00"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="00"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#242535"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalcDot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="."
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                app:backgroundTint="#242535"
                app:cornerRadius="12dp" />

            <!-- ক্যাশে বসান -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPostToCashDrawer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="ক্যাশে বসান"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:backgroundTint="#7C3AED"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Hidden compat views -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalcPercent" android:layout_width="0dp" android:layout_height="0dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalcQuickPlus5" android:layout_width="0dp" android:layout_height="0dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalcQuickPlus10" android:layout_width="0dp" android:layout_height="0dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalcQuickPlus15" android:layout_width="0dp" android:layout_height="0dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalcQuickMinus5" android:layout_width="0dp" android:layout_height="0dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCalcQuickMinus10" android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. RATE × QUANTITY VIEW -->
    <LinearLayout
        android:id="@+id/layoutRateQtyCalc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Rate Input -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:hint="দর / রেট (৳)"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxStrokeColor="#8B5CF6"
                app:hintTextColor="#C4B5FD"
                app:prefixText="৳ "
                app:prefixTextColor="#FFFFFF">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRatePrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Quantity Input -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:hint="পরিমাণ"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxStrokeColor="#8B5CF6"
                app:hintTextColor="#C4B5FD">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRateQty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Unit Chips (কেজি, গ্রাম, লিটার, পিস, ডজন, বস্তা) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="একক নির্বাচন করুন:"
            android:textColor="#94A3B8"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipUnitKg"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_filter_tab_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="কেজি"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
