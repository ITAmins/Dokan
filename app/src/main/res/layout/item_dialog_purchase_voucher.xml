<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0"
    app:cardBackgroundColor="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row: Date/Time with calendar icon & Amount -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/tvVoucherAmount"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_notebook"
                    app:tint="#7C3AED"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvVoucherDateTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="19 August, 2026 (09:04 PM)"
                    android:textColor="#1E293B"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVoucherAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="৳৮,২১৯"
                android:textColor="#D97706"
                android:textSize="16sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Middle Row: Purchase Type & Dealer Tag Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvVoucherType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="সরাসরি ক্রয়"
                android:textColor="#0F172A"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/tvVoucherDealerBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/shape_capsule_white"
                android:backgroundTint="#EDE9FE"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="সরাসরি ডিলার"
                android:textColor="#6D28D9"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Bottom Row: Note -->
        <TextView
            android:id="@+id/tvVoucherNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="নোট: মাল কেনা"
            android:textColor="#64748B"
            android:textSize="12sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
